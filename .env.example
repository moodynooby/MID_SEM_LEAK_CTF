# =================================================================
# Case File: The Mid-Sem Leak — CTFd Environment Configuration
# IEEE AUSB CTF - 28/10/2026
# =================================================================

# Port on the host machine to bind Nginx (80 is recommended for LAN)
HOST_PORT=80

# Secret key used for session signing (Generate a 32+ char random string)
SECRET_KEY=change_me_to_a_random_secret_key_for_event_32chars_long

# Number of Gunicorn worker processes for CTFd (recommend 4-8 for 80 concurrent participants)
CTFD_WORKERS=4

# MariaDB credentials
MYSQL_ROOT_PASSWORD=ausb_midsem_root_pass_change_me
MYSQL_USER=ctfd
MYSQL_PASSWORD=ausb_midsem_ctfd_pass_change_me
MYSQL_DATABASE=ctfd

# CTFd Admin API token (used for ops automation scripts: scoreboard blackout, timed challenges)
# Generate from: CTFd Admin Panel -> Settings -> Access Tokens
CTFD_ADMIN_TOKEN=your_ctfd_admin_api_token_here
CTFD_API_URL=http://localhost

# Timed-event bonus challenge names (optional; defaults shown below).
# `vanishing_start` refuses to broadcast unless this challenge exists in CTFd.
BONUS_VANISHING_CHALLENGE=Vanishing
BONUS_LIGHTNING_CHALLENGE=Lightning
