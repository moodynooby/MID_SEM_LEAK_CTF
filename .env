# Port on the host machine to bind Nginx (80 is standard so participants just visit http://<LAN_IP>)
HOST_PORT=80

# Secret key used for session signing
SECRET_KEY=c4e7f89d3a1b5c2e0f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e

# Gunicorn worker processes (4 workers handle 80+ simultaneous users easily)
CTFD_WORKERS=4

# MariaDB credentials
MYSQL_ROOT_PASSWORD=ieee_ausb_midsem_root_sec_2026!
MYSQL_USER=ctfd
MYSQL_PASSWORD=ieee_ausb_ctfd_db_user_2026!
MYSQL_DATABASE=ctfd

# CTFd Admin API token (generate inside CTFd UI -> Profile -> Access Tokens for ops scripts)
CTFD_ADMIN_TOKEN=placeholder_generate_after_ctfd_first_run
CTFD_API_URL=http://localhost
